# Copy this file to .env and fill in real values. .env is gitignored and
# never committed - this file is the template that IS committed, so anyone
# setting up the project (or deploying it) knows exactly which env vars
# config/settings.py expects.

# Core
SECRET_KEY=
DEBUG=True
DJANGO_ENVIRONMENT=local

# Database (Postgres)
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=6543

# Face recognition
FACE_MATCH_TOLERANCE=0.6

# Email (Gmail SMTP) - use a Gmail App Password, not your real account password
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Weather widget (https://openweathermap.org/api) - optional, widget is skipped if unset
WEATHER_API_KEY=
WEATHER_DEFAULT_CITY=Bangalore

# Firebase Cloud Messaging (push notifications) - path to the service-account
# JSON from Firebase Console > Project Settings > Service Accounts; push
# sending is skipped cleanly if the file isn't there.
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# Celery + Redis (scheduled WhatsApp reports / CRM lead polling)
CELERY_BROKER_URL=redis://localhost:6379/5
CELERY_TASK_ALWAYS_EAGER=False

# Encrypts stored integration credentials (WhatsApp tokens) at rest. Leave
# unset locally (derives from SECRET_KEY); set explicitly and keep stable in
# production so rotating SECRET_KEY doesn't make saved tokens unreadable.
INTEGRATION_ENCRYPTION_KEY=

# WhatsApp Cloud API base - only override to point at a local fake server for testing
WHATSAPP_GRAPH_BASE=https://graph.facebook.com

# Linked-phone (QR) WhatsApp helper (whatsapp_web/server.mjs) - leave
# WHATSAPP_WEB_TOKEN unset to use the token the helper auto-creates in
# whatsapp_web/data/token on first start.
WHATSAPP_WEB_URL=http://127.0.0.1:3100
WHATSAPP_WEB_TOKEN=
