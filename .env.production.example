# Production VPS — copy to .env on the server
APP_PORT=80
DEBUG=False
SECRET_KEY=replace-with-a-long-random-production-secret
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,your.vps.ip
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# External PostgreSQL (Supabase / managed Postgres)
DB_NAME=postgres
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your-db-host.example.com
DB_PORT=6543

# Optional
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
WEATHER_API_KEY=
